{
  "evaluation_protocol": {
    "level": "image_level",
    "definition": "gt_violation=1 当且仅当该图标签中至少有一个 class==1(no_helmet) 框；pred_violation=1 当且仅当规则引擎返回至少一个 code==NO_HELMET 事件。",
    "limitation": "标签无 person/vehicle 标注，无法区分骑乘者违规与路人违规，Precision 会被路人误报拉低；该口径不是框级 mAP。",
    "fps_definition": "rule_fps = 1000/avg_decide_ms，仅统计规则引擎纯 CPU 判定，不含检测器 GPU 推理与图像解码。",
    "inference_config": {
      "helmet_model": "E:\\基于YOLO\\backend\\models\\best.pt",
      "helmet_imgsz": 960,
